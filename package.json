{
  "name": "dsh-multi-user",
  "version": "0.1.0",
  "description": "Single-process multi-user workspace view partitioning for DeepSeek Harness: JWT-in-cookie login wall, per-user workspace/session filtering, and admin user management.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "zh-CN": "多用户",
        "en": "Multi User"
      },
      "summary": {
        "zh-CN": "JWT 登录墙 + 按用户分档工作区/会话 + 用户管理（单进程视图分档）",
        "en": "JWT login wall + per-user workspace/session partitioning + user management (single-process view partitioning)"
      },
      "category": "multi-user"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib",
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:watch": "tsx watch scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "multi-user",
    "multi-tenant",
    "workspace-partitioning",
    "jwt",
    "authentication"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nabin-qq273274877/dsh-multi-user.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.7",
    "react": "^18.2.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.7",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
